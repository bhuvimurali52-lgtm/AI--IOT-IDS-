# Application
APP_NAME=AI-Powered IoT Intrusion Detection
APP_VERSION=0.7.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
# Dashboard must point at the Phase 5 FastAPI process (same port as API_PORT).
# If an older Phase 3 server is still bound to 8000, stop it and restart uvicorn.
DASHBOARD_API_URL=http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLE_DIR=data/sample
MODELS_DIR=models

# Phase 2 CSV (optional)
DATASET_PATH=data/raw/dataset.csv
TARGET_COLUMN=label
TEST_SIZE=0.2
RANDOM_STATE=42

# Phase 3 IDS
IDS_MODE=synthetic
CAPTURE_INTERFACE=
CAPTURE_DURATION=10
CAPTURE_PACKET_COUNT=100
CAPTURE_BPF_FILTER=
MODEL_PATH=models/anomaly_detector.joblib
PREPROCESSOR_PATH=models/baseline_preprocessor.joblib
DATABASE_PATH=data/ids.db
ANOMALY_CONTAMINATION=0.05
N_ESTIMATORS=100
ALERT_RISK_THRESHOLD=60
FLOW_TIMEOUT_SECONDS=5
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79

DATABASE_URL=sqlite:///./iot_ids.db
