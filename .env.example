# Application
APP_NAME=AI-Powered IoT Intrusion Detection
APP_VERSION=0.8.0
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8502
# Dashboard must point at the FastAPI process (same port as API_PORT).
DASHBOARD_API_URL=http://127.0.0.1:8000

# CORS — explicit origins for the Streamlit dashboard. Do not use * in production.
# Do not enable credentials with wildcard origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLE_DIR=data/sample
MODELS_DIR=models

# Phase 2 CSV (optional)
DATASET_PATH=data/raw/dataset.csv
TARGET_COLUMN=label
TEST_SIZE=0.2
RANDOM_STATE=42

# Phase 3 IDS
IDS_MODE=synthetic
CAPTURE_INTERFACE=
CAPTURE_DURATION=10
CAPTURE_PACKET_COUNT=100
CAPTURE_BPF_FILTER=
MODEL_PATH=models/anomaly_detector.joblib
PREPROCESSOR_PATH=models/baseline_preprocessor.joblib
DATABASE_PATH=data/ids.db
ANOMALY_CONTAMINATION=0.05
N_ESTIMATORS=100
ALERT_RISK_THRESHOLD=60
FLOW_TIMEOUT_SECONDS=5
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79

DATABASE_URL=sqlite:///./iot_ids.db
